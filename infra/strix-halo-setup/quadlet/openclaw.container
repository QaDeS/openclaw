[Unit]
Description=OpenClaw Daemon

[Container]
Image=localhost/openclaw:latest
ContainerName=openclaw_daemon
Network=host
Volume=/home/claw/openclaw:/app
Volume=/home/claw/.openclaw:/root/.openclaw
Environment=NODE_ENV=production
Environment=LOCAL_LLM_URL=%LOCAL_LLM_URL%

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
