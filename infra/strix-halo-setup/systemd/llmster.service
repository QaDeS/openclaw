[Unit]
Description=LM Studio Headless Daemon (llmster)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=lmstudio
Environment=HOME=/home/lmstudio
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
Environment=PYTORCH_ALLOC_CONF=expandable_segments:True
ExecStartPre=/home/lmstudio/.lmstudio/bin/lms daemon up
ExecStart=/home/lmstudio/.lmstudio/bin/lms server start
ExecStop=/home/lmstudio/.lmstudio/bin/lms daemon down

[Install]
WantedBy=multi-user.target
